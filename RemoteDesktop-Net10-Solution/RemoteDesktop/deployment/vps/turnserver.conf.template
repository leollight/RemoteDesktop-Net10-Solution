# Private Coturn Relay Template (rendered on server during TURN installation)
listening-port={{TURN_PORT}}
tls-listening-port=5349

# Bind/advertise external IP when behind cloud NAT (uncomment/set if VPS uses 1:1 NAT)
# listening-ip=0.0.0.0
# external-ip={{TURN_EXTERNAL_IP}}

# TLS certificates readable by turnserver user (synced from Certbot via certbot-coturn-hook.sh)
cert=/etc/coturn/certs/fullchain.pem
pkey=/etc/coturn/certs/privkey.pem
cipher-list="ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384"

fingerprint
use-auth-secret
static-auth-secret={{TURN_SHARED_SECRET}}
realm={{TURN_REALM}}

# Ephemeral relay port range
min-port=49152
max-port=65535

# Security hardening: block peer access to loopback/private infrastructure ranges
no-loopback-peers
no-multicast-peers
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=127.0.0.0-127.255.255.255

no-cli
stale-nonce=600

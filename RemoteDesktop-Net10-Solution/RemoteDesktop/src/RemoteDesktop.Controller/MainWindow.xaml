<Window x:Class="RemoteDesktop.Controller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RemoteDesktop Controller" Height="300" Width="520">
    <StackPanel Margin="20">
        <TextBlock Text="RemoteDesktop Portable Controller" FontSize="16" FontWeight="SemiBold"/>
        <TextBlock x:Name="ConfigStatusText" Margin="0,10,0,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="MediaStatusText" Margin="0,10,0,0" Foreground="DimGray" TextWrapping="Wrap"/>
    </StackPanel>
</Window>
